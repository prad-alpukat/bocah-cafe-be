SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_ADMIN_REGISTRATION=true

# Database Configuration
# For SQLite (default/local development):
# DATABASE_URL=sqlite:///./bocah_cafe.db
# For MySQL Azure:
# DATABASE_URL=mysql+pymysql://username:password@your-server.mysql.database.azure.com:3306/bocah_cafe?charset=utf8mb4
# For Turso (production):
DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Firebase Configuration
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-key.json
# For cloud deployment, use FIREBASE_CREDENTIALS with JSON string instead of file:
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...",...}

# AI Configuration (Groq API for natural language search)
# Single key or comma-separated multiple keys for load balancing
GROQ_API_KEYS=your-groq-api-key

# Port (set by Railway automatically)
# PORT=8000
